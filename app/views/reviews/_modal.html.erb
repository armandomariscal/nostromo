<dialog
  id="reviews-modal"
  class="w-full max-w-2xl rounded-2xl bg-zinc-900 p-0 text-white shadow-2xl backdrop:bg-black/70"
>
    <div class="flex items-center justify-between border-b border-zinc-800 px-6 py-5">
        <div>
            <h2 class="text-xl font-bold">
                Reviews
            </h2>
            <p class="mt-1 text-sm text-zinc-500">
                <%= @movie.title %>
            </p>
        </div>
        <button
            type="button"
            onclick="document.getElementById('reviews-modal').close()"
            class="rounded-lg p-2 text-zinc-400 transition hover:bg-zinc-800 hover:text-white"
            aria-label="Close"
        >
            ✕
        </button>
  </div>
  <div class="max-h-[60vh] overflow-y-auto p-6">
    <% if @movie.reviews.any? %>

  <div class="space-y-4">
    <% @movie.reviews.each do |review| %>
      <div class="rounded-xl bg-zinc-800 p-4">

        <div class="flex items-center justify-between">
          <span class="text-sm font-semibold text-white">
            <%= review.user.username %>
          </span>

          <span class="text-sm font-semibold text-yellow-400">
            ★ <%= review.rating %>/10
          </span>
        </div>

        <p class="mt-3 leading-6 text-zinc-300">
          <%= review.content %>
        </p>

      </div>
    <% end %>
  </div>

    <% else %>

    <div class="py-10 text-center">
        <p class="text-zinc-500">
            This movie does not have any reviews yet.
        </p>
    </div>

    <% end %>

  </div>
</dialog>
