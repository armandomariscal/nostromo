<div class="max-w-xl mx-auto p-6">
    <h1 class="text-2xl font-bold mb-6">
        Review: <%= @movie.title %>
    </h1>
    <%= form_with model: @review, url: movie_review_path(@movie) do |form| %>
    <div class="mb-6">
        <%= form.label :content, "Review", class: "block mb-2 font-medium" %>
        <%= form.text_area :content,
            rows: 6,
            class: "w-full rounded-lg border border-gray-300 p-3" 
        %>
    </div>
    <div class="mb-6">
        <%= form.label :rating, "Rating", class: "block mb-2 font-medium" %>
        <div class="flex gap-2">
            <% (1..10).each do |rating| %>
            <label>
                <%= form.radio_button :rating, rating %>
                <%= rating %>
            </label>
            <% end %>
        </div>
    </div>
    <%= form.submit "Submit Review",
        class: "rounded-lg bg-black px-5 py-2 text-white" %>
    <% end %>
</div>
