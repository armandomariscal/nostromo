<% content_for :title, "Review: #{@movie.title}" %>

<%= render "movies/navbar",
      total_movies: @total_movies,
      viewed_movies: @viewed_movies,
      progress_percentage: @progress_percentage %>

<div class="mx-auto min-h-screen px-6 py-10 bg-zinc-950 text-white mt-14">
  <div class="max-w-xl mx-auto">
    <%= link_to "← Back to detail",
        movie_path(@movie),
        class: "mb-6 inline-block text-sm text-zinc-400 hover:text-white transition-colors" %>

    <div class="rounded-2xl bg-zinc-900 p-8 shadow-2xl border border-zinc-800">
      <h1 class="text-2xl font-bold mb-6 text-white">
        Review: <%= @movie.title %>
      </h1>

      <%= form_with model: @review, url: movie_review_path(@movie) do |form| %>
        <div class="mb-6">
          <%= form.label :content, "Review", class: "block mb-2 font-medium text-zinc-200" %>
          <%= form.text_area :content,
              rows: 6,
              placeholder: "Write your thoughts about the movie...",
              class: "w-full rounded-xl border border-zinc-700 bg-zinc-800 p-4 text-white placeholder-zinc-500 focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500" 
          %>
        </div>

        <div class="mb-6">
          <%= form.label :rating, "Rating", class: "block mb-2 font-medium text-zinc-200" %>
          <div class="flex flex-wrap gap-2">
            <% (1..10).each do |rating| %>
              <label class="flex items-center gap-1.5 cursor-pointer rounded-lg border border-zinc-700 bg-zinc-800 px-3 py-2 text-sm text-zinc-200 hover:bg-zinc-700 has-[:checked]:bg-indigo-600 has-[:checked]:border-indigo-500 has-[:checked]:text-white transition-all">
                <%= form.radio_button :rating, rating, class: "accent-indigo-500" %>
                <span><%= rating %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="mt-8 flex justify-end gap-3">
          <%= link_to "Cancel",
              movie_path(@movie),
              class: "rounded-lg px-4 py-2 text-sm font-medium text-zinc-400 hover:text-white transition-colors" %>

          <%= form.submit "Submit Review",
              class: "cursor-pointer rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white transition hover:bg-indigo-500" %>
        </div>
      <% end %>
    </div>
  </div>
</div>