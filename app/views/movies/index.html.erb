<div class="min-h-screen bg-zinc-950 text-zinc-100">

  <!-- Navbar -->
<nav class="fixed inset-x-0 top-0 z-50 border-b border-zinc-800 bg-zinc-950/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-7xl items-center px-6">

    <!-- Izquierda -->
    <div class="flex w-1/3 justify-start">
      <h1 class="text-2xl font-bold tracking-wide">
        Nostromo
      </h1>
    </div>

    <!-- Centro -->
    <div class="flex w-1/3 justify-center">
      <span class="text-zinc-300 font-medium tracking-wide">
        Alien Movie Collection
      </span>
    </div>

    <!-- Derecha -->
    <div class="flex w-1/3 justify-end">
      <span class="text-sm text-zinc-500">
        v0.1.0
      </span>
    </div>

  </div>
</nav>

  <!-- Contenido -->
  <main class="mx-auto max-w-7xl px-6 pt-24 pb-10">

    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">

      <% @movies.each do |movie| %>
        <% viewed = movie.user_movies.find_by(user: @current_user)&.viewed %>

        <div class="
          overflow-hidden rounded-xl shadow-lg transition
          hover:-translate-y-1 hover:shadow-2xl
          <%= viewed ? 'bg-zinc-900' : 'bg-zinc-900 opacity-60' %>
        ">

          <img
            src="/covers/<%= movie.year %>.jpg"
            alt="<%= movie.title %>"
            class="
              aspect-[2/3] w-full object-cover
              <%= 'grayscale' unless viewed %>
            "
          >

          <div class="p-4">

            <div class="flex items-start justify-between gap-2">
              <div>
                <h2 class="text-lg font-semibold">
                  <%= movie.title %>
                </h2>

                <p class="mt-1 text-sm text-zinc-400">
                  <%= movie.year %>
                </p>
              </div>

              <% if viewed %>
                <span class="rounded bg-green-600 px-2 py-1 text-xs font-medium">
                  Viewed
                </span>
              <% end %>
            </div>

          </div>

        </div>
      <% end %>

    </div>

  </main>

</div>