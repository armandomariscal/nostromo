<div class="min-h-screen bg-zinc-950 text-zinc-100">
  <div class="mx-auto max-w-7xl px-6 py-10">

    <div class="mb-10">
      <h1 class="text-4xl font-bold tracking-wide">
        Nostromo
      </h1>

      <p class="mt-2 text-zinc-400">
        Alien Movie Collection
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">

      <% @movies.each do |movie| %>
        <% viewed = movie.user_movies.find_by(user: @current_user)&.viewed %>

        <div class="
          overflow-hidden rounded-xl shadow-lg transition
          hover:-translate-y-1 hover:shadow-2xl
          <%= viewed ? 'bg-zinc-900' : 'bg-zinc-900 opacity-60' %>
        ">

          <img
            src="/covers/<%= movie.year %>.jpg"
            alt="<%= movie.title %>"
            class="
              aspect-[2/3] w-full object-cover
              <%= 'grayscale' unless viewed %>
            "
          >

          <div class="p-4">

            <div class="flex items-start justify-between gap-2">
              <div>
                <h2 class="text-lg font-semibold">
                  <%= movie.title %>
                </h2>

                <p class="mt-1 text-sm text-zinc-400">
                  <%= movie.year %>
                </p>
              </div>

              <% if viewed %>
                <span class="rounded bg-green-600 px-2 py-1 text-xs font-medium">
                  Viewed
                </span>
              <% end %>
            </div>

          </div>

        </div>
      <% end %>

    </div>

  </div>
</div>
