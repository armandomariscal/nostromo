<div class="min-h-screen bg-zinc-950 text-zinc-100">

  <!-- Navbar -->
  <nav class="fixed inset-x-0 top-0 z-50 border-b border-zinc-800 bg-zinc-950/90 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-7xl items-center px-6">

      <div class="flex w-1/3 justify-start">
        <h1 class="text-2xl font-bold tracking-wide">
          Nostromo
        </h1>
      </div>

      <div class="flex w-1/3 justify-center">
        <span class="text-zinc-300 font-medium tracking-wide">
          Alien Movie Collection
        </span>
      </div>

      <div class="flex w-1/3 justify-end">
        <span class="text-sm text-zinc-500">
          v0.1.0
        </span>
      </div>

    </div>
  </nav>

  <main class="mx-auto max-w-7xl px-6 pt-24 pb-10">

    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5">

      <% @movies.each do |movie| %>
        <%= render "movie",
            movie: movie,
            current_user: @current_user %>
      <% end %>

    </div>

  </main>

</div>