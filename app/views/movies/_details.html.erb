<div class="grid gap-8 md:grid-cols-[320px_1fr]">

  <div id="movie-cover-<%= movie.id %>">
    <div class="relative">
      <img
        src="/covers/<%= movie.year %>.jpg"
        alt="<%= movie.title %>"
        class="w-full rounded-xl <%= 'grayscale' unless viewed %>"
      >

      <% if viewed %>
        <span class="absolute left-2 top-2 rounded bg-green-600 px-2 py-1 text-xs text-white">
          Viewed
        </span>
      <% end %>
    </div>

    <div class="mt-2">
      <%= render "movies/viewed_button",
          movie: movie,
          user_movie: user_movie %>
    </div>
  </div>

  <div>
    <p class="text-sm uppercase tracking-widest text-zinc-500">
      Alien Collection
    </p>

    <h1 class="mt-2 text-5xl font-bold text-white">
      <%= movie.title %>
    </h1>

    <p class="mt-2 text-xl text-zinc-400">
      <%= movie.year %>
    </p>

    <section class="mt-10">
      <h2 class="text-lg font-semibold text-white">
        Overview
      </h2>

      <p class="mt-3 text-zinc-300">
        Information about this movie will be displayed here.
      </p>

      <div class="mt-6 flex gap-3">
        <%= link_to new_movie_review_path(movie),
            class: "rounded-lg bg-white px-4 py-2 text-sm text-zinc-900 hover:bg-zinc-200" do %>
          ✎ Add review
        <% end %>

        <button
          type="button"
          onclick="document.getElementById('reviews-modal').showModal()"
          class="rounded-lg bg-zinc-800 px-4 py-2 text-sm text-zinc-200 hover:bg-zinc-700"
        >
          ★ View reviews (<%= movie.reviews.count %>)
        </button>
      </div>

      <% review = movie.latest_review %>

      <% if review %>
        <div class="mt-6 rounded-lg bg-zinc-800 p-4">
          <p class="text-xs uppercase tracking-widest text-zinc-500">
            Latest review
          </p>

          <div class="mt-2 flex items-center justify-between">
            <span class="font-semibold text-white">
              <%= review.movie_title %>
            </span>

            <span class="text-sm text-zinc-400">
              <%= review.movie_year %>
            </span>
          </div>

          <p class="mt-2 text-yellow-400">
            ★ <%= review.rating %>/10
          </p>

          <p class="mt-2 text-sm text-zinc-300">
            <%= review.content %>
          </p>
        </div>
      <% end %>
    </section>
  </div>

</div>
