<% content_for :title, @movie.title %>
<% viewed = @user_movie&.viewed || false %>

<%= render "navbar",
    total_movies: @total_movies,
    viewed_movies: @viewed_movies,
    progress_percentage: @progress_percentage %>

<div class="min-h-screen bg-zinc-950 px-6 py-10 mt-14">
  <%= link_to "← Back to collection", root_path,
      class: "mb-8 inline-block text-sm text-zinc-400 hover:text-white" %>

  <main class="mx-auto max-w-6xl">
    <div class="rounded-2xl bg-zinc-900 p-8">

      <%= render "movies/details",
          movie: @movie,
          viewed: viewed,
          user_movie: @user_movie %>

      <%= render "movies/crew_members",
          crew_members: @crew_members %>

      <%= render "movies/ships",
          ships: @ships %>

    </div>
  </main>
</div>

<%= render "confirm_modal",
    movie: @movie,
    viewed: viewed %>

<%= render "reviews/modal",
    movie: @movie %>
