<% user_movie = movie.user_movies.find_by(user: current_user) %>
<% viewed = user_movie&.viewed || false %>

<%= turbo_frame_tag dom_id(movie) do %>

  <div
    data-movie-card
    data-movie-url="<%= movie_path(movie) %>"
    class="
      cursor-pointer rounded-xl border border-transparent bg-zinc-900 transition
      hover:border-green-600
      <%= 'opacity-60' unless viewed %>
    "
  >

    <div class="relative">
      <%= link_to movie_path(movie), data: { turbo: false } do %>
        <img
          src="/covers/<%= movie.year %>.jpg"
          alt="<%= movie.title %>"
          class="aspect-[2/3] w-full rounded-t-xl object-cover <%= 'grayscale' unless viewed %>"
        >
      <% end %>

      <% if viewed %>
        <span class="absolute left-2 top-2 rounded bg-green-600/70 px-2 py-0.5 text-[10px] text-white">
          Viewed
        </span>
      <% end %>

      <span class="compact-year absolute bottom-2 right-2 rounded bg-zinc-900/80 px-2 py-1 text-xs font-medium text-zinc-300 backdrop-blur-sm">
        <%= movie.year %>
      </span>
    </div>

    <div class="p-4">
      <h2 class="text-lg font-semibold text-white compact-title">
        <%= movie.title %>
      </h2>

      <p class="mt-1 text-sm text-zinc-400 movie-year">
        <%= movie.year %>
      </p>

      <div class="mt-4 compact-button">
        <%= render "movies/viewed_button",
            movie: movie,
            user_movie: user_movie %>
      </div>
    </div>

  </div>

<% end %>

<%= render "movies/confirm_modal",
    movie: movie,
    viewed: viewed %>
